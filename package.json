{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "lint:date-fns": "bash scripts/lint-date-fns.sh",
    "lint:all": "bash scripts/lint-all.sh",
    "lint:watch": "bash scripts/lint-watch.sh",
    "lint:date-fns:fix": "eslint . --config eslint.date-fns.config.js --fix",
    "fix:date-fns": "bash scripts/fix-date-fns.sh",
    "fix:date-fns:dry": "bash scripts/fix-date-fns.sh --all --dry-run",
    "precommit:fix": "bash scripts/fix-date-fns.sh --staged",
    "ci:lint:date-fns": "eslint . --config eslint.date-fns.config.js --max-warnings=0",
    "preview": "vite preview",
    "verify:date-fns": "node scripts/verify-datefns-versions.mjs",
    "verify:datefns-locale-coverage": "node scripts/datefns-locale-coverage.mjs",
    "verify:package": "node scripts/verify-package-versions.mjs",
    "verify:packages:all": "node scripts/verify-package-versions.mjs --all",
    "verify:critical-deps": "node scripts/verify-critical-deps.mjs",
    "smoke:date-fns": "bash scripts/smoke-date-fns.sh",
    "date-fns:smoke": "bash scripts/smoke-date-fns.sh",
    "ci:check": "bash scripts/ci-check.sh",
    "ci:smoke": "bash scripts/ci-smoke.sh",
    "deps:health": "node scripts/diff-dependency-health.mjs",
    "deps:health:generate": "node scripts/generate-dependency-health.mjs",
    "verify:datefns": "bun run verify:datefns-smoke && bun run verify:datefns-smoke-types",
    "verify:datefns-locales": "node scripts/verify-datefns-locales.mjs",
    "verify:datefns-smoke": "node scripts/generate-datefns-smoke-test.mjs --dry-run",
    "verify:datefns-smoke-types": "bunx tsc --noEmit -p tsconfig.smoke.json",
    "verify:datefns-smoke-freshness": "node scripts/verify-datefns-smoke-freshness.mjs",
    "verify:datefns-locale-delta": "node scripts/datefns-locale-delta.mjs",
    "verify:datefns-locale-delta:json": "node scripts/datefns-locale-delta.mjs --json --out ci-logs/datefns-locale-delta.json --quiet",
    "verify:datefns-generator-input": "node scripts/verify-datefns-generator-input.mjs",
    "verify:datefns-generator-input:write": "node scripts/verify-datefns-generator-input.mjs --write",
    "verify:datefns-files": "node scripts/verify-datefns-files.mjs",
    "verify:datefns-files:write": "node scripts/verify-datefns-files.mjs --write-health",
    "verify:install-report": "bun install --frozen-lockfile && node scripts/install-report.mjs --strict",
    "verify:install-report:json": "node scripts/install-report.mjs --json > public/install-report.json",
    "verify:install-report:prom": "node scripts/install-report.mjs --json | node scripts/install-report-export.mjs --format=prom",
    "verify:install-report:csv": "node scripts/install-report.mjs --json | node scripts/install-report-export.mjs --format=csv",
    "pretest": "node scripts/verify-datefns-files.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "ci:report": "node scripts/ci/report-generator.mjs",
    "test:date-fns": "vitest run src/test/dateFns.smoke.test.ts --reporter=verbose --passWithNoTests",
    "test:date-fns:format": "vitest run src/test/dateFns.smoke.test.ts -t \"format\" --reporter=verbose --passWithNoTests",
    "test:date-fns:watch": "vitest watch src/test/dateFns.smoke.test.ts --reporter=verbose",
    "test:date-fns:parity": "node scripts/verify-test-datefns-parity.mjs",
    "pretypecheck": "node scripts/verify-datefns-files.mjs",
    "typecheck": "tsc --noEmit",
    "hook:datefns": "bash scripts/hooks/datefns-precommit.sh",
    "test:hook:datefns": "bash scripts/__tests__/datefns-precommit-summary.test.sh",
    "test:hook:datefns:fixtures": "bash scripts/__tests__/datefns-hook-fixtures.test.sh",
    "test:hook:datefns:all": "bash scripts/__tests__/datefns-precommit-summary.test.sh && bash scripts/__tests__/datefns-hook-fixtures.test.sh",
    "hook:smoke:enable": "git config --local hook.fullSmoke true && echo 'Full smoke enabled on pre-push'",
    "hook:smoke:disable": "git config --local hook.fullSmoke false && echo 'Full smoke disabled on pre-push'",
    "prepare": "husky || true",
    "lint:src": "eslint src --max-warnings=0",
    "lint:src:fix": "eslint src --fix"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
