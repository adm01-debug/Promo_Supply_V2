{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "lodash": "^4.18.1",
    "ws": "^8.21.0",
    "dompurify": "^3.4.17"
