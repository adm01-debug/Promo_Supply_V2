#!/usr/bin/env bash
# Husky pre-push hook.
#
# Lightweight mode (default):
#   1. scripts/hooks/datefns-precommit.sh
#        — generator-drift gate + tsc smoke check.
#   2. bun run smoke:date-fns
#        — regenerates the date-fns smoke test from current src/ imports,
#          verifies every imported subpath exists on disk, and runs the
#          smoke test. Catches missing date-fns subpaths BEFORE the branch
#          is shared.
#
# Full mode (opt-in): runs scripts/ci-smoke.sh instead.
#   FULL_SMOKE_PRE_PUSH=1 git push          # one-time
#   bun run hook:smoke:enable               # persistent (per-repo git config)
#   bun run hook:smoke:disable              # return to lightweight mode
#
# To bypass entirely: `git push --no-verify`.
#
# Targeted bypass (skip the date-fns gates only, keep everything else):
#   SKIP_DATEFNS_HOOK=1 git push
# Aliases accepted (any of these set to 1/true/yes): SKIP_DATEFNS_HOOK,
# SKIP_DATE_FNS_HOOK, LOVABLE_SKIP_DATEFNS. Useful for emergency pushes,
# WIP branches, or when you've already verified locally with
# `bun run verify:datefns`.
set -euo pipefail

HOOK_DIR="$(dirname "$0")"
ROOT_DIR="$(cd "$HOOK_DIR/.." && pwd)"

# Normalize the skip flag — accept 1, true, yes (case-insensitive).
_skip_raw="${SKIP_DATEFNS_HOOK:-${SKIP_DATE_FNS_HOOK:-${LOVABLE_SKIP_DATEFNS:-}}}"
_skip_lc="$(printf '%s' "$_skip_raw" | tr '[:upper:]' '[:lower:]')"
case "$_skip_lc" in
  1|true|yes)
    echo "⚠  pre-push: SKIP_DATEFNS_HOOK is set — skipping date-fns verification."
    echo "   Reason: explicit env-var bypass. Re-enable by unsetting the variable."
    echo "   Tip: run \`bun run verify:datefns\` before merging to confirm sync."
    exit 0
    ;;
esac

if [ "${FULL_SMOKE_PRE_PUSH:-}" = "1" ] || \
   [ "$(git config --local hook.fullSmoke 2>/dev/null || echo false)" = "true" ]; then
  echo "▶ Running full ci-smoke.sh (opt-in mode)..."
  exec bash "$ROOT_DIR/scripts/ci-smoke.sh"
fi

# ── Lightweight mode ──────────────────────────────────────────────────────────
echo "▶ [pre-push 1/2] date-fns precommit gate..."
bash "$ROOT_DIR/scripts/hooks/datefns-precommit.sh"

echo "▶ [pre-push 2/2] date-fns smoke (subpath existence + smoke test)..."
# Prefer bun if available so the script hits the same toolchain CI uses;
# fall back to invoking the shell script directly otherwise.
if command -v bun >/dev/null 2>&1; then
  ( cd "$ROOT_DIR" && bun run smoke:date-fns )
else
  bash "$ROOT_DIR/scripts/smoke-date-fns.sh"
fi

# ── Optional: refresh public/dependency-health.json on push ──────────────────
# Opt-in via `WRITE_DEP_HEALTH=1 git push`. Keeps the default pre-push fast and
# read-only — but lets contributors who *want* an up-to-date snapshot in their
# push regenerate it without remembering the exact flag set. A `--dry-run`
# escape hatch (`WRITE_DEP_HEALTH=dry`) previews the change without touching
# the file, useful when checking whether a push would dirty the working tree.
case "${WRITE_DEP_HEALTH:-}" in
  1|true|yes)
    echo "▶ [pre-push opt-in] WRITE_DEP_HEALTH=$WRITE_DEP_HEALTH — refreshing public/dependency-health.json..."
    ( cd "$ROOT_DIR" && node scripts/verify-datefns-files.mjs --write-health ) || {
      echo "✗ pre-push: --write-health failed; snapshot was not updated." >&2
      exit 1
    }
    if ! git -C "$ROOT_DIR" diff --quiet -- public/dependency-health.json; then
      echo "  ⚠ public/dependency-health.json changed — review & commit before re-pushing."
    else
      echo "  ✓ public/dependency-health.json already up to date."
    fi
    ;;
  dry|dry-run)
    echo "▶ [pre-push opt-in] WRITE_DEP_HEALTH=dry — previewing snapshot diff (no write)..."
    ( cd "$ROOT_DIR" && node scripts/verify-datefns-files.mjs --write-health --dry-run ) || {
      echo "✗ pre-push: --write-health --dry-run failed." >&2
      exit 1
    }
    ;;
  "")
    : # default: skip silently
    ;;
  *)
    echo "  ⚠ Ignoring WRITE_DEP_HEALTH=$WRITE_DEP_HEALTH (expected 1|true|yes|dry)."
    ;;
esac
