# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PRODUÇÃO
# ==============================================================================
# Copie este arquivo para .env e preencha com os valores reais

# SUPABASE
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# BITRIX24 (opcional - se integrado)
VITE_BITRIX_WEBHOOK_URL=https://promobrindes.bitrix24.com.br/rest/1/seu-webhook/

# APP CONFIG
VITE_APP_NAME=Sistema Empresarial
VITE_APP_ENV=production

# FEATURES FLAGS
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# PUSH (Web Push / VAPID)
# Chave PUBLICA VAPID: mesmo par de VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY publicados nas env da
# edge function send-push-notification (a chave privada nunca sai do servidor).
# Sem ela o navegador nao cria a inscricao de push e a interface mostra "Push indisponivel
# neste ambiente" em vez de anunciar sucesso (etapa 288). No CI ela vem do secret
# VAPID_PUBLIC_KEY; na Vercel precisa existir como VITE_VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid-aqui

# ==============================================================================
# IMPORTANTE: Nunca commitar o arquivo .env com valores reais!
# ==============================================================================
